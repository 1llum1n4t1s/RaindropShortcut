{
  "name": "raindrop-shortcut",
  "version": "1.0.16",
  "type": "commonjs",
  "description": "Chrome extension to quickly access Raindrop.io bookmarks",
  "scripts": {
    "sync:support": "node --preserve-symlinks-main ./node_modules/kagayoi-support-extension/bin/kagayoi-support-sync.mjs",
    "prebuild": "pnpm sync:support",
    "test": "node --test",
    "generate-icons": "node scripts/generate-icons.js",
    "generate-screenshots": "node webstore/generate-screenshots.js",
    "build": "pnpm run generate-icons && pnpm run generate-screenshots"
  },
  "devDependencies": {
    "chrome-webstore-upload-cli": "^4.0.1",
    "kagayoi-support-extension": "1.0.5",
    "puppeteer": "^25.10.0",
    "sharp": "^0.35.4",
    "web-ext": "10.6.0",
    "wrangler": "4.129.0"
  },
  "keywords": [
    "chrome-extension",
    "raindrop",
    "bookmarks"
  ],
  "author": "ゆろち",
  "license": "MIT"
}
